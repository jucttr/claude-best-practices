{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(python3 *)", "Bash(git diff *)"],
    "ask": ["Bash(git push *)"],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(./secrets/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/scripts/session-start-demo.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[demo] 上下文已压缩，SessionStart(compact) 重新注入：本目录是 Claude Code 项目级配置学习样本，示例不依赖 git / 构建命令；机制说明在 docs/。校验标记 SESSION_START_COMPACT_OK'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[demo] PreToolUse/Bash 已触发；exit 0 放行，改成 exit 2 就会阻断调用'"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "my-tools": {
      "source": {
        "source": "github",
        "repo": "my-org/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "markdown-formatter@my-tools": true
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": ["/tmp/build"]
    },
    "network": {
      "allowedDomains": ["github.com", "raw.githubusercontent.com"]
    }
  },
  "plansDirectory": "./plans"
}
